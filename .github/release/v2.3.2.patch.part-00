+
+/* v2.3.2 responsive navigation and stale-markup hardening */
+.desktop-navigation {
+  min-width: 0;
+  flex: 1 1 auto;
+  display: flex;
+  align-items: stretch;
+  justify-content: space-between;
+  gap: clamp(0.75rem, 1.5vw, 1.5rem);
+}
+.desktop-nav {
+  min-width: 0;
+  display: flex;
+  align-items: stretch;
+  gap: clamp(0.15rem, 0.55vw, 0.55rem);
+}
+.desktop-nav a,
+.desktop-nav-menu summary,
+.desktop-nav-menu-link {
+  white-space: nowrap;
+  word-break: normal;
+  overflow-wrap: normal;
+  hyphens: none;
+}
+.desktop-nav a {
+  flex: 0 0 auto;
+  padding-inline: clamp(0.4rem, 0.72vw, 0.78rem);
+}
+.desktop-nav a:first-child { padding-left: 0.35rem; }
+.desktop-nav a::after { left: 0.4rem; right: 0.4rem; }
+.desktop-nav a:first-child::after { left: 0.35rem; }
+.desktop-nav-utilities {
+  flex: 0 0 auto;
+  display: flex;
+  align-items: stretch;
+  gap: 0.35rem;
+}
+.desktop-nav-menu {
+  position: relative;
+  display: flex;
+  align-items: stretch;
+}
+.desktop-nav-menu summary {
+  min-height: 3.2rem;
+  display: inline-flex;
+  align-items: center;
+  gap: 0.35rem;
+  padding-inline: 0.7rem;
