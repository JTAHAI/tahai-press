{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tahai.net/tahai-press/schemas/article.schema.json",
  "title": "TAHAI Press Article",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "status",
    "article_type",
    "featured",
    "allow_download",
    "show_author_bio",
    "noindex"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "article_type": {
      "enum": [
        "standard",
        "pdf",
        "mixed",
        "external"
      ]
    },
    "kicker": {
      "type": "string",
      "maxLength": 100
    },
    "excerpt": {
      "type": "string",
      "minLength": 0,
      "maxLength": 360
    },
    "body": {
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "updated_at": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "categories": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "hub": {
      "type": "string"
    },
    "featured": {
      "type": "boolean"
    },
    "featured_image": {
      "type": "string"
    },
    "featured_image_alt": {
      "type": "string",
      "maxLength": 240
    },
    "pdf_file": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "pdf_title": {
      "type": "string",
      "maxLength": 180
    },
    "document_description": {
      "type": "string",
      "maxLength": 600
    },
    "document_date": {
      "type": "string"
    },
    "document_pages": {
      "type": "integer",
      "minimum": 0
    },
    "document_source": {
      "type": "string",
      "maxLength": 180
    },
    "external_link_label": {
      "type": "string",
      "maxLength": 100
    },
    "allow_download": {
      "type": "boolean"
    },
    "pdf_viewer_default": {
      "type": "string",
      "enum": [
        "fit-width",
        "fit-page"
      ],
      "default": "fit-width"
    },
    "show_author_bio": {
      "type": "boolean"
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "seo_title": {
      "type": "string",
      "maxLength": 70
    },
    "seo_description": {
      "type": "string",
      "maxLength": 170
    },
    "canonical_url": {
      "type": "string"
    },
    "legacy_urls": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 900
      }
    },
    "noindex": {
      "type": "boolean"
    },
    "review_content": {
      "type": "boolean",
      "default": false
    },
    "review_rights": {
      "type": "boolean",
      "default": false
    },
    "review_accessibility": {
      "type": "boolean",
      "default": false
    },
    "editor_notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "excerpt",
          "published_at",
          "author",
          "categories",
          "review_content",
          "review_rights",
          "review_accessibility"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 180
          },
          "excerpt": {
            "type": "string",
            "minLength": 20,
            "maxLength": 360
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "review_content": {
            "const": true
          },
          "review_rights": {
            "const": true
          },
          "review_accessibility": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "const": "published"
              }
            },
            "required": [
              "status"
            ]
          },
          {
            "properties": {
              "article_type": {
                "enum": [
                  "standard",
                  "mixed"
                ]
              }
            },
            "required": [
              "article_type"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "const": "published"
              }
            },
            "required": [
              "status"
            ]
          },
          {
            "properties": {
              "article_type": {
                "enum": [
                  "pdf",
                  "mixed",
                  "external"
                ]
              }
            },
            "required": [
              "article_type"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "pdf_title"
        ],
        "properties": {
          "pdf_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "const": "published"
              }
            },
            "required": [
              "status"
            ]
          },
          {
            "properties": {
              "article_type": {
                "const": "external"
              }
            },
            "required": [
              "article_type"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "pdf_url"
        ],
        "properties": {
          "pdf_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        }
      }
    }
  ]
}
