{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tahai.net/tahai-press/schemas/article.schema.json",
  "title": "TAHAI Press Article",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "status",
    "article_type",
    "featured",
    "allow_download",
    "show_author_bio",
    "noindex"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "status": {
      "enum": [
        "draft",
        "scheduled",
        "published",
        "archived"
      ]
    },
    "article_type": {
      "enum": [
        "standard",
        "pdf",
        "mixed",
        "external"
      ]
    },
    "kicker": {
      "type": "string",
      "maxLength": 100
    },
    "excerpt": {
      "type": "string",
      "minLength": 0,
      "maxLength": 360
    },
    "body": {
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "updated_at": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "categories": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "hub": {
      "type": "string"
    },
    "featured": {
      "type": "boolean"
    },
    "featured_image": {
      "type": "string"
    },
    "featured_image_alt": {
      "type": "string",
      "maxLength": 240
    },
    "featured_image_caption": {
      "type": "string",
      "maxLength": 300
    },
    "featured_image_credit": {
      "type": "string",
      "maxLength": 160
    },
    "featured_image_rights": {
      "type": "string",
      "maxLength": 300
    },
    "featured_image_aspect": {
      "type": "string",
      "enum": [
        "original",
        "landscape",
        "portrait",
        "square"
      ],
      "default": "landscape"
    },
    "featured_image_focal_point": {
      "type": "string",
      "enum": [
        "center",
        "top",
        "bottom",
        "left",
        "right"
      ],
      "default": "center"
    },
    "pdf_file": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "pdf_title": {
      "type": "string",
      "maxLength": 180
    },
    "document_description": {
      "type": "string",
      "maxLength": 600
    },
    "document_accessible_summary": {
      "type": "string",
      "maxLength": 5000,
      "description": "Plain-language HTML alternative for the essential meaning and context of a PDF or externally hosted document."
    },
    "document_accessibility_note": {
      "type": "string",
      "maxLength": 600,
      "description": "Optional note explaining the limits, remediation status, or available alternative for the source document."
    },
    "document_date": {
      "type": "string"
    },
    "document_pages": {
      "type": "integer",
      "minimum": 0
    },
    "document_source": {
      "type": "string",
      "maxLength": 180
    },
    "external_link_label": {
      "type": "string",
      "maxLength": 100
    },
    "allow_download": {
      "type": "boolean"
    },
    "pdf_viewer_default": {
      "type": "string",
      "enum": [
        "fit-width",
        "fit-page"
      ],
      "default": "fit-width"
    },
    "show_author_bio": {
      "type": "boolean"
    },
    "story_blocks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/textBlock"
          },
          {
            "$ref": "#/$defs/keyPointsBlock"
          },
          {
            "$ref": "#/$defs/pullQuoteBlock"
          },
          {
            "$ref": "#/$defs/factBoxBlock"
          },
          {
            "$ref": "#/$defs/imageBlock"
          },
          {
            "$ref": "#/$defs/galleryBlock"
          },
          {
            "$ref": "#/$defs/timelineBlock"
          },
          {
            "$ref": "#/$defs/calloutBlock"
          },
          {
            "$ref": "#/$defs/documentBlock"
          },
          {
            "$ref": "#/$defs/listBlock"
          },
          {
            "$ref": "#/$defs/dataTableBlock"
          },
          {
            "$ref": "#/$defs/noticeBlock"
          }
        ]
      }
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "seo_title": {
      "type": "string",
      "maxLength": 70
    },
    "seo_description": {
      "type": "string",
      "maxLength": 170
    },
    "canonical_url": {
      "type": "string"
    },
    "legacy_urls": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 900
      }
    },
    "noindex": {
      "type": "boolean"
    },
    "review_content": {
      "type": "boolean",
      "default": false
    },
    "review_rights": {
      "type": "boolean",
      "default": false
    },
    "review_accessibility": {
      "type": "boolean",
      "default": false
    },
    "editor_notes": {
      "type": "string",
      "maxLength": 2000
    },
    "classification": {
      "enum": [
        "news",
        "analysis",
        "opinion",
        "investigation",
        "public-record",
        "explainer",
        "interview",
        "announcement",
        "developing"
      ]
    },
    "series_slug": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "series_title": {
      "type": "string",
      "maxLength": 180
    },
    "series_description": {
      "type": "string",
      "maxLength": 360
    },
    "series_order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "related_articles": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "methodology": {
      "type": "string",
      "maxLength": 5000
    },
    "disclosure": {
      "type": "string",
      "maxLength": 2000
    },
    "rights_and_reuse": {
      "type": "string",
      "maxLength": 1000
    },
    "what_changed": {
      "type": "string",
      "maxLength": 1000
    },
    "update_history": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "body"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "corrections": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "body"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "published",
              "scheduled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "classification",
          "excerpt",
          "published_at",
          "author",
          "categories",
          "review_content",
          "review_rights",
          "review_accessibility"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 180
          },
          "excerpt": {
            "type": "string",
            "minLength": 20,
            "maxLength": 360
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "review_content": {
            "const": true
          },
          "review_rights": {
            "const": true
          },
          "review_accessibility": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "enum": [
                  "published",
                  "scheduled"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          {
            "properties": {
              "article_type": {
                "enum": [
                  "standard",
                  "mixed"
                ]
              }
            },
            "required": [
              "article_type"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "enum": [
                  "published",
                  "scheduled"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          {
            "properties": {
              "article_type": {
                "enum": [
                  "pdf",
                  "mixed",
                  "external"
                ]
              }
            },
            "required": [
              "article_type"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "pdf_title"
        ],
        "properties": {
          "pdf_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "enum": [
                  "published",
                  "scheduled"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          {
            "properties": {
              "article_type": {
                "const": "external"
              }
            },
            "required": [
              "article_type"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "pdf_url"
        ],
        "properties": {
          "pdf_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "enum": [
                  "published",
                  "scheduled"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          {
            "properties": {
              "article_type": {
                "enum": [
                  "pdf",
                  "mixed",
                  "external"
                ]
              }
            },
            "required": [
              "article_type"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "document_description",
          "document_accessible_summary"
        ],
        "properties": {
          "document_description": {
            "type": "string",
            "minLength": 20,
            "maxLength": 600
          },
          "document_accessible_summary": {
            "type": "string",
            "minLength": 40,
            "maxLength": 5000
          }
        }
      }
    }
  ],
  "$defs": {
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "body"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "heading": {
          "type": "string",
          "maxLength": 160
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "keyPointsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "key_points"
        },
        "heading": {
          "type": "string",
          "maxLength": 160
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "pullQuoteBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "quote"
      ],
      "properties": {
        "type": {
          "const": "pull_quote"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "attribution": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "factBoxBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "heading",
        "body"
      ],
      "properties": {
        "type": {
          "const": "fact_box"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "imageBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "src",
        "alt"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "heading": {
          "type": "string",
          "maxLength": 160
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "maxLength": 240
        },
        "caption": {
          "type": "string",
          "maxLength": 300
        },
        "credit": {
          "type": "string",
          "maxLength": 160
        },
        "rights": {
          "type": "string",
          "maxLength": 300
        },
        "decorative": {
          "type": "boolean",
          "default": false
        },
        "layout": {
          "type": "string",
          "enum": [
            "standard",
            "wide",
            "full",
            "left",
            "right"
          ],
          "default": "standard"
        },
        "aspect": {
          "type": "string",
          "enum": [
            "original",
            "landscape",
            "portrait",
            "square"
          ],
          "default": "original"
        },
        "focal_point": {
          "type": "string",
          "enum": [
            "center",
            "top",
            "bottom",
            "left",
            "right"
          ],
          "default": "center"
        },
        "lightbox": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "galleryBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "gallery"
        },
        "heading": {
          "type": "string",
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/mediaItem"
          }
        }
      }
    },
    "timelineBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "timeline"
        },
        "heading": {
          "type": "string",
          "maxLength": 160
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title"
            ],
            "properties": {
              "date": {
                "type": "string",
                "maxLength": 80
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "body": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "calloutBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "heading",
        "body"
      ],
      "properties": {
        "type": {
          "const": "callout"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "note",
            "important",
            "context"
          ],
          "default": "neutral"
        }
      }
    },
    "documentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "heading",
        "url"
      ],
      "properties": {
        "type": {
          "const": "document"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "listBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "enum": ["numbered_findings", "source_list", "related_coverage"] },
        "heading": { "type": "string", "maxLength": 180 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "dataTableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "columns", "rows"],
      "properties": {
        "type": { "const": "data_table" },
        "heading": { "type": "string", "maxLength": 180 },
        "description": { "type": "string", "maxLength": 600 },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 12000 }
        }
      }
    },
    "noticeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "body"],
      "properties": {
        "type": { "enum": ["correction_notice", "update_notice", "editor_note", "definition_box", "methodology_box"] },
        "heading": { "type": "string", "maxLength": 180 },
        "body": { "type": "string", "minLength": 1, "maxLength": 5000 }
      }
    },
    "mediaItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "maxLength": 240
        },
        "caption": {
          "type": "string",
          "maxLength": 300
        },
        "credit": {
          "type": "string",
          "maxLength": 160
        },
        "rights": {
          "type": "string",
          "maxLength": 300
        },
        "decorative": {
          "type": "boolean",
          "default": false
        },
        "layout": {
          "type": "string",
          "enum": [
            "standard",
            "wide",
            "full",
            "left",
            "right"
          ],
          "default": "standard"
        },
        "aspect": {
          "type": "string",
          "enum": [
            "original",
            "landscape",
            "portrait",
            "square"
          ],
          "default": "original"
        },
        "focal_point": {
          "type": "string",
          "enum": [
            "center",
            "top",
            "bottom",
            "left",
            "right"
          ],
          "default": "center"
        },
        "lightbox": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
