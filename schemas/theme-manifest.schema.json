{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TAHAI Press declarative theme manifest",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "author", "license", "description", "compatibility", "capabilities", "entry_points"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "author": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "compatibility": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "entry_points": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^styles/[a-z-]+\\.css$" } },
    "preview": { "type": "string", "pattern": "^assets/[a-z0-9-]+\\.webp$" },
    "asset_budgets": { "type": "object" }
  },
  "additionalProperties": false
}
